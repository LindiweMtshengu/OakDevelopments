@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-content">
        <h1>Find Your Dream Home</h1>
        <p>Browse properties, connect with agents, and discover the perfect place to live.</p>
    </div>
</section>

<section class="search-section">
    <div class="search-grid">
        <div class="search-card">
            <h2>Search Properties</h2>
            <form method="get" asp-page="/Properties/Search">
                <label for="location">Location</label>
                <input id="location" name="Location" placeholder="City or Suburb" />

                <label for="minPrice">Min Price</label>
                <input id="minPrice" name="MinPrice" type="number" />

                <label for="maxPrice">Max Price</label>
                <input id="maxPrice" name="MaxPrice" type="number" />

                <button type="submit">Search Properties</button>
            </form>
        </div>

        <div class="search-card">
            <h2>Search Agents</h2>
            <form method="get" asp-page="/Agents/Search">
                <label for="agentLocation">Location</label>
                <input id="agentLocation" name="Location" placeholder="City or Suburb" />

                <button type="submit">Search Agents</button>
            </form>
        </div>
    </div>
</section>
