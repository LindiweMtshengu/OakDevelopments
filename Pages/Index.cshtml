@page
@model IndexModel
@{
    ViewData["Title"] = "Property Listings";
}

<h1>@ViewData["Title"]</h1>

<!-- Main Section for Listings -->
<section id="properties" style="display:flex; flex-wrap:wrap; gap:20px;">

    <!-- Property Card 1 -->
    <section class="property-card" style="border:1px solid #ccc; border-radius:8px; padding:15px; width:300px; background:#f9f9f9;">
        <header>
            <h3>2-Bedroom Apartment</h3>
        </header>
        <p><strong>Description:</strong> Modern apartment with open-plan kitchen and balcony.</p>
        <p><strong>Price:</strong> R1,200,000</p>
        <p><strong>Location:</strong> Johannesburg</p>
    </section>

    <!-- Property Card 2 -->
    <section class="property-card" style="border:1px solid #ccc; border-radius:8px; padding:15px; width:300px; background:#f9f9f9;">
        <header>
            <h3>3-Bedroom House</h3>
        </header>
        <p><strong>Description:</strong> Spacious family home with garden and garage.</p>
        <p><strong>Price:</strong> R2,500,000</p>
        <p><strong>Location:</strong> Pretoria</p>
    </section>

</section>