@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<header>
    <h1>Oak FDevelopments</h1>
</header>

<main>
    <section aria-labelledby="property-search">
        <h2 id="property-search">Find Your Dream Property</h2>
        <a asp-page="/Properties/Search" class="btn">Search Properties</a>
    </section>

    <section aria-labelledby="agent-search">
        <h2 id="agent-search">Find an Agent Near You</h2>
        <a asp-page="/Agents/Search" class="btn">Search Agents</a>
    </section>
</main>

<footer>
    <nav aria-label="Footer navigation">
        <ul>
            <li><a asp-page="/About">About Us</a></li>
            <li><a asp-page="/Contact">Contact</a></li>
            <li><a asp-page="/Terms">Terms</a></li>
            <li><a asp-page="/Privacy">Privacy</a></li>
        </ul>
    </nav>
    <p>&copy; 2026 Oak FDevelopments</p>
</footer>