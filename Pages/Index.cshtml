@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<main>

    <!-- HERO SECTION -->
    <section class="hero" aria-labelledby="hero-heading">
        <div class="container">

            <header class="hero-content text-center">
                <h1 id="hero-heading">Find Your Dream Home</h1>
                <p>Luxury living starts here...</p>
            </header>

        </div>
    </section>

    <!-- SEARCH SECTION -->
    <section class="search-section mt-5" aria-labelledby="search-heading">
        <div class="container">

            <header>
                <h2 id="search-heading" class="mb-4 text-center">
                    Search
                </h2>
            </header>

            <div class="row">

                <!-- PROPERTY SEARCH -->
                <section class="col-12 col-md-6" aria-labelledby="property-search-heading">

                    <article class="card p-4 shadow">

                        <header>
                            <h3 id="property-search-heading" class="mb-3">
                                Search Properties
                            </h3>
                        </header>

                        <form method="get" asp-page="/Properties/Search">

                            <div class="mb-3">
                                <label for="location">Location</label>
                                <input id="location" class="form-control" name="Location" placeholder="City or Suburb" />
                            </div>

                            <div class="mb-3">
                                <label for="minPrice">Min Price</label>
                                <input id="minPrice" class="form-control" name="MinPrice" type="number" />
                            </div>

                            <div class="mb-3">
                                <label for="maxPrice">Max Price</label>
                                <input id="maxPrice" class="form-control" name="MaxPrice" type="number" />
                            </div>

                            <button class="btn btn-dark w-100">
                                Search Properties
                            </button>

                        </form>

                    </article>

                </section>

                <!-- AGENT SEARCH -->
                <section class="col-12 col-md-6" aria-labelledby="agent-search-heading">

                    <article class="card p-4 shadow">

                        <header>
                            <h3 id="agent-search-heading" class="mb-3">
                                Search Agents
                            </h3>
                        </header>

                        <form method="get" asp-page="/Agents/Search">

                            <div class="mb-3">
                                <label for="agentLocation">Location</label>
                                <input id="agentLocation" class="form-control" name="Location" placeholder="City or Suburb" />
                            </div>

                            <button class="btn btn-outline-dark w-100">
                                Search Agents
                            </button>

                        </form>

                    </article>

                </section>

            </div>

        </div>
    </section>

</main>