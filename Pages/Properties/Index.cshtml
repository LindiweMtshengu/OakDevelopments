@page
@model OakDevelopments.Pages.Properties.IndexModel

@{
    ViewData["Title"] = "Properties";
}

<main class="container">

    <!-- PAGE HEADER -->
    <header>
        <h1 class="mb-4">Available Properties</h1>
    </header>

    <!-- PROPERTY LIST -->
    <section class="property-grid" aria-label="Available properties">

        @if (Model.Properties != null && Model.Properties.Any())
        {
            foreach (var property in Model.Properties)
            {
                <article class="property-card">

                    <!-- IMAGE GALLERY (NO fullscreen here) -->
                    @if (property.Images != null && property.Images.Any())
                    {
                        <div class="property-gallery">

                            <!-- MAIN IMAGE -->
                            <div class="main-image">
                                <img src="@property.Images.First().ImagePath"
                                     alt="Main image of @property.Title" />
                            </div>

                            <!-- THUMBNAILS -->
                            <div class="thumbnail-images">
                                @foreach (var img in property.Images.Skip(1).Take(3))
                                {
                                    <img src="@img.ImagePath"
                                         alt="Additional view of @property.Title" />
                                }
                            </div>

                        </div>
                    }

                    <!--PROPERTY CONTENT -->
                    <header>
                        <h3>@property.Title</h3>
                    </header>

                    <p>
                        <strong>Location:</strong>
                        @property.Suburb, @property.City
                    </p>


                    <p class="price-row">
                        <span class="price-label">Price</span>
                        <span class="price">
                            R @property.Price.ToString("N0").Replace(",", " ")
                        </span>
                    </p>

                    
                    <p>
                        <strong>Agent:</strong> @property.Agent?.FirstName @property.Agent?.LastName
                    </p>


                    <!-- ACTION -->
                    <footer>
                        <a asp-page="/Properties/Details"
                           asp-route-id="@property.ID"
                           class="btn btn-dark">
                            View Details
                        </a>
                    </footer>

                </article>
            }
        }
        else
        {
            <p>No properties available at the moment.</p>
        }

    </section>

</main>