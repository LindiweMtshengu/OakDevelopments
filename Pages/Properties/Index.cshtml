@page
@model OakDevelopments.Pages.Properties.IndexModel

@{
    ViewData["Title"] = "Properties";
}

<h1 class="mb-4">Available Properties</h1>

<div class="property-grid">

    @foreach (var property in Model.Properties)
    {
        <div class="property-card">

@*             <img src="@property.ImagePath" alt="Property Image" style="width:100%; height:200px; object-fit:cover; border-radius:10px;" />
 *@
            <h3>@property.Title</h3>

            <p><strong>Location:</strong> @property.Suburb, @property.City</p>

            <p><strong>Price:</strong> R @property.Price</p>

            <a href="/Properties/Details?id=@property.ID" class="btn btn-dark">View Details</a>

        </div>
    }

</div>
