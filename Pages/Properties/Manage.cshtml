@page
@model OakDevelopments.Pages.Properties.ManageModel

<main class="container mt-5">

    <h2 class="text-center mb-4" style="font-size:2rem; letter-spacing:0.5px;">
        Manage Properties
    </h2>

    <div class="row g-4">

        @foreach (var property in Model.Properties)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <div class="card shadow-sm border-0 h-100">

                    <!-- IMAGE -->

                    <div style="height:220px; overflow:hidden;">

                        @if (property.Images != null && property.Images.Any())
                        {
                            <img src="@property.Images.First().ImagePath"
                                 style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center h-100">
                                No Image
                            </div>
                        }

                    </div>


                    <!-- CARD BODY -->
                    <div class="card-body d-flex flex-column">

                        <h5 class="fw-semibold mb-1">
                            @property.Title
                        </h5>

                        <p class="text-muted mb-2">
                            @property.City, @property.Province
                        </p>

                        <h6 class="text-dark fw-bold mb-3">
                            R @property.Price.ToString("N0")
                        </h6>

                        <!-- ACTION BUTTONS -->
                        <div class="mt-auto d-flex gap-2">

                            <a asp-page="/Properties/Edit"
                               asp-route-id="@property.ID"
                               class="btn btn-outline-dark w-100">
                                Edit
                            </a>

                            <form method="post"
                                  asp-page-handler="Delete"
                                  class="w-100">

                                <input type="hidden"
                                       name="id"
                                       value="@property.ID" />

                                <button type="submit"
                                        class="btn btn-danger w-100">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>

                </div>

            </div>
        }

    </div>

</main>
