@page
@model PropertiesSearchModel
@{
    ViewData["Title"] = "Property Search";
}

<main class="container">

    <!-- PAGE HEADER -->
    <header>
        <h2>Search Properties</h2>
    </header>

    <!-- FILTER SECTION -->
    <section aria-labelledby="filters">
        <header>
            <h3 id="filters">Filters</h3>
        </header>

        <form method="get" class="filter-bar">

            <div class="filter-item">
                <label for="type">Type</label>
                <select id="type" asp-for="SearchType">
                    <option value="">Any</option>
                    <option>House</option>
                    <option>Apartment</option>
                </select>
            </div>

            <div class="filter-item">
                <label for="minPrice">Min Price</label>
                <input id="minPrice" asp-for="MinPrice" type="number" />
            </div>

            <div class="filter-item">
                <label for="maxPrice">Max Price</label>
                <input id="maxPrice" asp-for="MaxPrice" type="number" />
            </div>

            <div class="filter-item">
                <label for="bedrooms">Bedrooms</label>
                <input id="bedrooms" asp-for="Bedrooms" type="number" />
            </div>

            <div class="filter-item">
                <label for="location">Location</label>
                <input id="location" asp-for="Location" />
            </div>

            <div class="filter-button">
                <button type="submit">Search</button>
            </div>

        </form>
    </section>

    <!-- RESULTS SECTION -->
    <section aria-labelledby="results">

        <header>
            <h3 id="results">Results</h3>
        </header>

        <!-- RESULT SUMMARY -->
        <p class="results-summary">
            @if (!string.IsNullOrEmpty(Model.Location))
            {
                <span>Showing properties in <strong>@Model.Location</strong></span>
            }
        </p>

        <!-- GRID -->
        <section class="property-grid">

            @if (Model.Results != null && Model.Results.Any())
            {
                foreach (var property in Model.Results)
                {
                    <article class="property-card">

                        @if (property.Images != null && property.Images.Any())
                        {
                            <div class="property-gallery">

                                <div class="main-image">
                                    <img src="@property.Images.First().ImagePath" alt="Main image" />
                                </div>

                                <div class="thumbnail-images">
                                    @foreach (var img in property.Images.Skip(1).Take(3))
                                    {
                                        <img src="@img.ImagePath" alt="Thumbnail" />
                                    }
                                </div>

                            </div>
                        }

                        <!-- ONLY wrap TEXT in link -->
                        <a asp-page="/Properties/Details" asp-route-id="@property.ID" style="text-decoration:none; color:inherit;">

                            <header>
                                <h4>@property.Title</h4>
                            </header>

                            <p>@property.Description</p>

                            <p class="price-row">
                                <span class="price-label">Price</span>
                                <span class="price">
                                    R @property.Price.ToString("N0").Replace(",", " ")
                                </span>
                            </p>
                            <p><strong>Bedrooms:</strong> @property.Bedrooms</p>
                            <p><strong>Location:</strong> @property.Suburb, @property.City</p>

                        </a>

                    </article>
                }

                <!-- FULLSCREEN IMAGE VIEWER -->


                <div id="imageModal" class="image-modal">

                    <span class="close-btn">&times;</span>

                    <div id="modalScroll" class="modal-content">
                    </div>

                </div>



            }
            else
            {
                <p>No properties found for your search.</p>
            }

        </section>

    </section>

</main>
