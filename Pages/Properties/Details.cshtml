@page "{id:int}"
@model DetailsModel

<main class="container">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["Error"]
        </div>
    }

    <h2>@Model.Property.Title</h2>


    @if (Model.Property.Images != null && Model.Property.Images.Any())
    {
        <div class="property-gallery details-gallery">

            <!-- MAIN IMAGE -->
            <div class="main-image">
                <img src="@Model.Property.Images.First().ImagePath" />
            </div>

            <!-- THUMBNAILS -->
            <div class="thumbnail-images">
                @foreach (var img in Model.Property.Images.Skip(1))
                {
                    <img src="@img.ImagePath" />
                }
            </div>

        </div>
    }


    <!-- DETAILS -->

    <p class="price-row">
        <span class="price-label">Price</span>

        <span class="price">
            R @Model.Property.Price.ToString("N0").Replace(",", " ")
        </span>

    </p>

    <p>
        <strong>Status:</strong>

        <span class="badge @(Model.Property.StatusID == 1 ? "bg-success" : "bg-danger")">
            @Model.Property.Status?.StatusName
        </span>
    </p>

    <p>@Model.Property.Description</p>
    <p><strong>Bedrooms:</strong> @Model.Property.Bedrooms</p>

    <p><strong>Location:</strong> @Model.Property.Suburb, @Model.Property.City</p>

    @if (!string.IsNullOrEmpty(Model.Property.Amenities))
    {
        <div class="mt-3">
            <strong>Amenities:</strong><br />

            @foreach (var item in Model.Property.Amenities.Split(','))
            {
                <span class="badge bg-secondary me-1 mb-1">
                    @item.Trim()
                </span>
            }
        </div>
    }

    @if (TempData["MortgageResult"] != null)
    {
        <div class="alert alert-success text-center">
            @TempData["MortgageResult"]
        </div>
    }


    <h4 class="text-center">Mortgage Calculator</h4>

    <form method="post" asp-page-handler="CalculateMortgage" class="mt-3 mb-4">

        <input type="hidden" name="price" value="@Model.Property.Price" />

        <div class="mb-2">
            <input type="number" name="deposit" class="form-control" placeholder="Deposit (R)" required />
        </div>

        <div class="mb-2">
            <input type="number" step="0.01" name="interestRate" class="form-control" placeholder="Interest Rate (%)" required />
        </div>

        <div class="mb-2">
            <input type="number" name="years" class="form-control" placeholder="Loan Term (Years)" required />
        </div>

        <button class="btn btn-dark w-100">
            Calculate
        </button>

    </form>




    <h4 class="text-center">Location Map</h4>

    <div class="mt-3" style="width:100%; height:300px;">
        <iframe width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                allowfullscreen
                src="https://www.google.com/maps?q=Gauteng&output=embed">
        </iframe>
    </div>




    <!-- FULLSCREEN IMAGE MODAL -->
    <div id="imageModal" class="image-modal">

        <span class="close-btn">&times;</span>

        <div id="modalScroll" class="modal-content">
            <!-- Images injected here -->
        </div>

    </div>

    <hr />

    <h4>Agent Information</h4>


    @if (Model.Property.Agent != null)
    {
        <div class="d-flex align-items-center gap-3 mt-3">

            <!-- IMAGE GOES HERE -->
            @if (!string.IsNullOrEmpty(Model.Property.Agent.ProfilePhoto))
            {
                <img src="~/images/@Model.Property.Agent.ProfilePhoto"
                     class="img-fluid rounded"
                     style="width:120px; height:120px; object-fit:cover;" />
            }
            else
            {
                <img src="~/images/default.jpg"
                     class="img-fluid rounded"
                     style="width:120px; height:120px;" />
            }

            <!-- TEXT DETAILS -->
            <div>
                <h5>@Model.Property.Agent.FirstName @Model.Property.Agent.LastName</h5>
                <p>@Model.Property.Agent.Email</p>
                <p>@Model.Property.Agent.Phone</p>
            </div>

        </div>
    }
    else
    {
        <p>No agent assigned to this property.</p>
    }

    <hr />

    <div class="text-center mt-4">

        <form method="post" asp-page-handler="BookViewing">
            <input type="hidden" name="propertyId" value="@Model.Property.ID" />

            <button type="submit" class="btn btn-warning">
                Book Viewing
            </button>
        </form>

    </div>

</main>