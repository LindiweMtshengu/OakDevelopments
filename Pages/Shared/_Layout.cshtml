<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - OakDevelopments</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Custom Font -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
        /* ===== GLOBAL STYLING ===== */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fb;
            color: #1a1a1a;
        }

        h1, h2, h3, .navbar-brand {
            font-family: 'Playfair Display', serif;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background-color: #ffffff;
        }

        .navbar-brand {
            font-size: 1.5rem;
            letter-spacing: 1px;
        }

        .navbar-nav .nav-link {
            font-weight: 500;
            margin-right: 10px;
        }

        .navbar-nav .nav-link:hover {
            color: #d4af37;
        }

        /* ===== FOOTER ===== */
        .footer {
            background-color: #ffffff;
            padding: 20px 0;
            text-align: center;
            font-size: 0.9rem;
        }

        /* ===== MOBILE IMPROVEMENTS ===== */
        @@media (max-width: 768px) {
            .navbar-brand {
                font-size: 1.2rem;
            }
        }
    </style>
</head>

<body>

    <!-- ===== HEADER ===== -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom shadow-sm">
            <div class="container-fluid px-4">

                <!-- LOGO -->
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <span style="color:#d4af37;">OakDevelopments</span>
                </a>

                <!-- MOBILE TOGGLE -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- NAV CONTENT -->
                <div class="collapse navbar-collapse" id="mainNav">

                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Properties/Index">Properties</a>
                        </li>

                        <!-- DROPDOWN -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                Admin
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-page="/Properties/Add">Add Property</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-page="/Properties/Index">Manage Properties</a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Privacy">Privacy</a>
                        </li>

                    </ul>

                    <!-- LOGIN -->
                    <div class="ms-auto">
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="footer border-top mt-5">
        <div class="container">
            <p>
                &copy; 2026 - OakDevelopments |
                <a asp-page="/Privacy">Privacy</a>
            </p>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
