<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OakDevelopments</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OakDevelopments.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- HEADER + NAVIGATION -->
    <header>
        <nav class="border-bottom shadow-sm" aria-label="Main navigation">
            <div class="container d-flex align-items-center justify-content-between">

                <!-- LOGO -->
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <span style="color:#d4af37;">OakDevelopments</span>
                </a>

                <!-- NAV LIST -->
                <ul class="nav-links mx-auto" role="menubar">

                    <li>
                        <a asp-page="/Index" class="nav-link">Home</a>
                    </li>

                    <li>
                        <a asp-page="/Properties/Index" class="nav-link">Properties</a>
                    </li>

                    <!-- ADMIN DROPDOWN -->
                    <li class="dropdown position-relative">

                        <a href="#" class="nav-link dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                            Admin
                        </a>

                        <ul class="dropdown-menu" role="menu" aria-label="Admin menu">
                            <li><a asp-page="/Properties/Add">Add Property</a></li>
                            <li><a asp-page="/Properties/Index">Manage Properties</a></li>
                        </ul>
                    </li>

                    <li>
                        <a asp-page="/Privacy" class="nav-link">Privacy</a>
                    </li>

                </ul>

                <partial name="_LoginPartial" />

            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main class="container pb-3" role="main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer border-top text-muted mt-4">
        <div class="container">
            <p>
                &copy; 2026 - OakDevelopments -
                <a asp-page="/Privacy">Privacy</a>
            </p>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>