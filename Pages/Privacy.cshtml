@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="privacy-section py-5">

    <div class="container">

        <div class="privacy-card mx-auto">

            <h1 class="text-center mb-4">Privacy Policy</h1>

            <p class="text-center text-muted mb-4">
                At <strong>OakDevelopments</strong>, we value your privacy and are committed to protecting your personal information.
            </p>

            <hr />

            <h4>1. Information We Collect</h4>
            <p>
                We may collect personal information including your name, email address, phone number,
                and booking details when you:
            </p>
            <ul>
                <li>Register or create an account</li>
                <li>Search for properties</li>
                <li>Submit a booking request</li>
                <li>Contact us</li>
            </ul>

            <hr />

            <h4>2. How We Use Your Information</h4>
            <ul>
                <li>Process property viewing bookings</li>
                <li>Connect you with real estate agents</li>
                <li>Send booking confirmations and updates</li>
                <li>Improve our platform and services</li>
            </ul>

            <hr />

            <h4>3. Sharing of Information</h4>
            <p>
                We do not sell your personal information.
                Your details may only be shared with assigned agents and authorized administrators.
            </p>

            <hr />

            <h4>4. Data Security</h4>
            <p>
                We take reasonable measures to protect your data against unauthorized access or misuse.
            </p>

            <hr />

            <h4>5. Your Rights</h4>
            <p>
                You have the right to access, update, or request deletion of your personal data.
            </p>

            <hr />

            <h4>6. Contact Us</h4>
            <p>
                <strong>Email:</strong> info@oakdevelopments.co.za <br />
                <strong>Location:</strong> Office 115, Midway Office Park, Midrand, Gauteng, 1686.
            </p>

        </div>

    </div>

</section>